{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "definitions": {
    "httpEndpoint": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://(?:\\[[0-9A-Fa-f:.]+\\]|[^/@:?\\s#\\\\]+)(?::(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?(?:/[^\\s?#\\\\]*)?$"
    },
    "httpsEndpoint": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://(?:\\[[0-9A-Fa-f:.]+\\]|[^/@:?\\s#\\\\]+)(?::(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?(?:/[^\\s?#\\\\]*)?$"
    },
    "httpRelativePath": {
      "type": "string",
      "format": "uri-reference",
      "minLength": 1,
      "maxLength": 2048,
      "allOf": [
        { "pattern": "^/[^\\s?#;\\\\]*$" },
        { "not": { "pattern": "^//" } },
        { "not": { "pattern": "(^|/)\\.{1,2}(/|$)" } }
      ]
    },
    "httpRequestHeader": {
      "type": "string",
      "maxLength": 255,
      "allOf": [
        { "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$" },
        {
          "not": {
            "pattern": "^(?i:authorization|proxy-authorization|cookie|host|content-length|content-type|transfer-encoding|connection|upgrade|te|trailer|proxy-connection|forwarded|x-forwarded-.+|x-real-ip|x-http-method|x-http-method-override|x-method-override|x-original-method|x-original-url|x-original-uri|x-rewrite-url)$"
          }
        }
      ]
    },
    "httpResponseHeader": {
      "type": "string",
      "maxLength": 255,
      "allOf": [
        { "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$" },
        { "not": { "pattern": "^(?i:authorization|proxy-authenticate|set-cookie|www-authenticate)$" } }
      ]
    },
    "databaseProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "host", "database", "username_file", "allowed_schemas"],
      "dependencies": {
        "client_certificate_file": ["client_key_file"],
        "client_key_file": ["client_certificate_file"]
      },
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 255 },
        "host": { "type": "string", "minLength": 1, "maxLength": 255 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "database": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_$-]{0,254}$" },
        "username_file": { "type": "string", "pattern": "^/" },
        "password_file": { "type": "string", "pattern": "^/" },
        "allow_insecure": { "type": "boolean" },
        "ca_bundle_file": { "type": "string", "pattern": "^/" },
        "client_certificate_file": { "type": "string", "pattern": "^/" },
        "client_key_file": { "type": "string", "pattern": "^/" },
        "server_name": { "type": "string", "minLength": 1, "maxLength": 255 },
        "allowed_schemas": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_$-]{0,254}$" }
        },
        "execute_sql_enabled": { "type": "boolean" },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maximum_concurrency": { "type": "integer", "minimum": 1, "maximum": 8 },
            "maximum_rows": { "type": "integer", "minimum": 1, "maximum": 1000 },
            "maximum_result_bytes": { "type": "integer", "minimum": 1024, "maximum": 1048576 },
            "maximum_query_bytes": { "type": "integer", "minimum": 256, "maximum": 65536 },
            "maximum_timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 30 }
          }
        }
      }
    },
    "httpProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "base_url", "allowed_methods", "allowed_path_prefixes"],
      "dependencies": {
        "authorization_scheme": ["authorization_file"],
        "authorization_file": ["authorization_scheme"],
        "username_file": ["password_file"],
        "password_file": ["username_file"],
        "client_certificate_file": ["client_key_file"],
        "client_key_file": ["client_certificate_file"]
      },
      "allOf": [
        {
          "if": {
            "required": ["base_url"],
            "properties": { "base_url": { "pattern": "^http://" } }
          },
          "then": {
            "required": ["allow_insecure_http"],
            "properties": { "allow_insecure_http": { "const": true } }
          }
        },
        {
          "not": {
            "anyOf": [
              { "required": ["bearer_token_file", "authorization_file"] },
              { "required": ["bearer_token_file", "username_file"] },
              { "required": ["bearer_token_file", "oauth2_client_credentials"] },
              { "required": ["authorization_file", "username_file"] },
              { "required": ["authorization_file", "oauth2_client_credentials"] },
              { "required": ["username_file", "oauth2_client_credentials"] }
            ]
          }
        }
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 255 },
        "base_url": { "$ref": "#/definitions/httpEndpoint" },
        "allow_insecure_http": { "type": "boolean" },
        "allowed_methods": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "uniqueItems": true,
          "items": { "enum": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"] }
        },
        "allowed_path_prefixes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/httpRelativePath" }
        },
        "allowed_request_headers": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/httpRequestHeader" }
        },
        "exposed_response_headers": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/httpResponseHeader" }
        },
        "health_check_path": { "$ref": "#/definitions/httpRelativePath" },
        "authorization_scheme": { "type": "string", "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$" },
        "authorization_file": { "type": "string", "pattern": "^/" },
        "bearer_token_file": { "type": "string", "pattern": "^/" },
        "username_file": { "type": "string", "pattern": "^/" },
        "password_file": { "type": "string", "pattern": "^/" },
        "header_files": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": { "$ref": "#/definitions/httpRequestHeader" },
          "additionalProperties": { "type": "string", "pattern": "^/" }
        },
        "oauth2_client_credentials": {
          "type": "object",
          "additionalProperties": false,
          "required": ["token_url", "client_id_file", "client_secret_file"],
          "properties": {
            "token_url": { "$ref": "#/definitions/httpsEndpoint" },
            "client_id_file": { "type": "string", "pattern": "^/" },
            "client_secret_file": { "type": "string", "pattern": "^/" },
            "scopes": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[^ \\t\\r\\n]+$" } },
            "audience": { "type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^[^\\r\\n]+$" },
            "client_auth_method": { "enum": ["client_secret_basic", "client_secret_post"] },
            "header_files": {
              "type": "object",
              "maxProperties": 32,
              "propertyNames": { "$ref": "#/definitions/httpRequestHeader" },
              "additionalProperties": { "type": "string", "pattern": "^/" }
            }
          }
        },
        "ca_bundle_file": { "type": "string", "pattern": "^/" },
        "client_certificate_file": { "type": "string", "pattern": "^/" },
        "client_key_file": { "type": "string", "pattern": "^/" },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maximum_concurrency": { "type": "integer", "minimum": 1, "maximum": 8 },
            "maximum_request_bytes": { "type": "integer", "minimum": 1, "maximum": 262144 },
            "maximum_response_bytes": { "type": "integer", "minimum": 1024, "maximum": 98304 },
            "maximum_timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 30 }
          }
        }
      }
    },
    "tempoProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "url"],
      "dependencies": {
        "username_file": ["password_file"],
        "password_file": ["username_file"],
        "client_certificate_file": ["client_key_file"],
        "client_key_file": ["client_certificate_file"]
      },
      "allOf": [
        {
          "if": {
            "required": ["url"],
            "properties": { "url": { "pattern": "^http://" } }
          },
          "then": {
            "required": ["allow_insecure_http"],
            "properties": { "allow_insecure_http": { "const": true } },
            "not": {
              "anyOf": [
                { "required": ["ca_bundle_file"] },
                { "required": ["client_certificate_file"] },
                { "required": ["client_key_file"] }
              ]
            }
          }
        },
        {
          "not": { "required": ["bearer_token_file", "username_file"] }
        }
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 255 },
        "url": { "$ref": "#/definitions/httpEndpoint" },
        "allow_insecure_http": { "type": "boolean" },
        "bearer_token_file": { "type": "string", "pattern": "^/" },
        "username_file": { "type": "string", "pattern": "^/" },
        "password_file": { "type": "string", "pattern": "^/" },
        "tenant_id_file": { "type": "string", "pattern": "^/" },
        "ca_bundle_file": { "type": "string", "pattern": "^/" },
        "client_certificate_file": { "type": "string", "pattern": "^/" },
        "client_key_file": { "type": "string", "pattern": "^/" },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maximum_concurrency": { "type": "integer", "minimum": 1, "maximum": 8 },
            "maximum_result_bytes": { "type": "integer", "minimum": 1024, "maximum": 2097152 },
            "maximum_traces": { "type": "integer", "minimum": 1, "maximum": 100 },
            "maximum_spans_per_span_set": { "type": "integer", "minimum": 1, "maximum": 10 },
            "maximum_attribute_values": { "type": "integer", "minimum": 1, "maximum": 1000 },
            "maximum_stale_values": { "type": "integer", "minimum": 1, "maximum": 10000 },
            "maximum_series": { "type": "integer", "minimum": 1, "maximum": 1000 },
            "maximum_points_per_series": { "type": "integer", "minimum": 1, "maximum": 11000 },
            "maximum_exemplars": { "type": "integer", "minimum": 1, "maximum": 100 },
            "maximum_range_seconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
            "maximum_timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 30 }
          }
        }
      }
    }
  },
  "properties": {
    "replicaCount": { "type": "integer", "const": 1 },
    "image": {
      "type": "object",
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^$|^sha256:[0-9a-f]{64}$" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "agent": {
      "type": "object",
      "required": ["grpcURL", "controlPlaneEnabled", "logLevel", "maximumConcurrency"],
      "properties": {
        "name": { "type": "string", "maxLength": 253 },
        "grpcURL": { "type": "string", "pattern": "^https://[^/]+/?$" },
        "controlPlaneEnabled": { "type": "boolean" },
        "logLevel": { "enum": ["debug", "info", "warn", "error"] },
        "maximumConcurrency": { "type": "integer", "minimum": 1, "maximum": 8 },
        "caBundleFile": { "type": "string", "pattern": "^$|^/" }
      }
    },
    "enrollment": {
      "type": "object",
      "required": ["token", "existingSecret", "secretKey"],
      "properties": {
        "token": { "type": "string" },
        "existingSecret": { "type": "string" },
        "secretKey": { "type": "string", "minLength": 1 }
      }
    },
    "providers": {
      "type": "object",
      "required": ["kubernetes", "prometheus", "loki", "mcp"],
      "properties": {
        "kubernetes": {
          "type": "object",
          "required": ["enabled", "id", "displayName", "policy"],
          "properties": {
            "enabled": { "type": "boolean" },
            "id": { "type": "string", "maxLength": 255 },
            "displayName": { "type": "string", "maxLength": 255 },
            "policy": {
              "type": "object",
              "required": [
                "allowedNamespaces", "allowClusterScoped", "defaultListLimit",
                "maximumListLimit", "defaultWatchSeconds", "maximumWatchSeconds",
                "maximumResultBytes", "allowPodLogs", "allowInsecureLogBackendTLS",
                "defaultLogBytes", "maximumLogBytes", "defaultLogSeconds",
                "maximumLogSeconds"
              ],
              "properties": {
                "allowedNamespaces": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 },
                  "uniqueItems": true
                },
                "allowClusterScoped": { "type": "boolean" },
                "defaultListLimit": { "type": "integer", "minimum": 1, "maximum": 1000 },
                "maximumListLimit": { "type": "integer", "minimum": 1, "maximum": 1000 },
                "defaultWatchSeconds": { "type": "integer", "minimum": 1, "maximum": 60 },
                "maximumWatchSeconds": { "type": "integer", "minimum": 1, "maximum": 60 },
                "maximumResultBytes": { "type": "integer", "minimum": 1, "maximum": 2097152 },
                "allowPodLogs": { "type": "boolean" },
                "allowInsecureLogBackendTLS": { "type": "boolean" },
                "defaultLogBytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
                "maximumLogBytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
                "defaultLogSeconds": { "type": "integer", "minimum": 1, "maximum": 60 },
                "maximumLogSeconds": { "type": "integer", "minimum": 1, "maximum": 60 }
              }
            }
          }
        },
        "prometheus": { "type": "array", "maxItems": 16 },
        "loki": { "type": "array", "maxItems": 16 },
        "tempo": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/definitions/tempoProvider" }
        },
        "mcp": { "type": "array", "maxItems": 16 },
        "postgresql": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "allOf": [
              { "$ref": "#/definitions/databaseProvider" },
              {
                "anyOf": [
                  { "required": ["password_file"] },
                  { "required": ["client_certificate_file", "client_key_file"] }
                ]
              }
            ]
          }
        },
        "mysql": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "allOf": [
              { "$ref": "#/definitions/databaseProvider" },
              { "required": ["password_file"] }
            ]
          }
        },
        "http": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/definitions/httpProvider" }
        }
      }
    },
    "persistence": {
      "type": "object",
      "required": ["enabled", "existingClaim", "storageClass", "accessModes", "size"],
      "properties": {
        "enabled": { "type": "boolean" },
        "existingClaim": { "type": "string" },
        "storageClass": { "type": "string" },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["ReadWriteOnce", "ReadOnlyMany", "ReadWriteMany", "ReadWriteOncePod"] }
        },
        "size": { "type": "string", "pattern": "^[0-9]+(Ei|Pi|Ti|Gi|Mi|Ki)$" }
      }
    }
  }
}
